# Copia este archivo y renombralo a  .env  (sin .example)
# Luego pega tu clave gratuita de API-Football despues del signo =
# La consigues registrandote en: https://dashboard.api-football.com/register

API_FOOTBALL_KEY=pega_aqui_tu_clave

# Clave de Zafronix (Mundial 2026 real, gratis). Registro en https://api.zafronix.com/
ZAFRONIX_KEY=pega_aqui_tu_clave_zafronix

# Puerto donde corre el servidor (puedes dejarlo asi)
PORT=3000
